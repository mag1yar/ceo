{
  "name": "desktop",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "vite": "vite",
    "check": "biome check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.wdio.json",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:e2e:app": "CARGO_TARGET_DIR=target/e2e tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json && wdio run wdio.conf.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.4",
    "@workspace/ui": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.5.0",
    "typescript": "~6.0.2",
    "vite": "^8",
    "webdriverio": "^9.32.0"
  }
}
