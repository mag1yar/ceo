{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "clippy": {},
    "test:rust": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
