{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "clippy": {},
    "test:rust": {},
    "test:e2e": {
      "dependsOn": ["^typecheck"],
      "passThroughEnv": ["E2E_PORT"],
      "outputs": ["test-results/**"]
    },
    "test:e2e:app": {
      "cache": false,
      "passThroughEnv": ["TAURI_WEBDRIVER_PORT"]
    },
    "test:e2e:measure": {
      "cache": false,
      "passThroughEnv": ["TAURI_WEBDRIVER_PORT"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
